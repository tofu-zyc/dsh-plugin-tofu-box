{
  "name": "dsh-plugin-shell-selector",
  "version": "0.1.0",
  "description": "在 设置 → Shell 页面选择 AI 命令执行所用的 shell（自动 / PowerShell 7 / Windows PowerShell 5.1 / Git Bash），带真实可用性检测。",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "keywords": ["dsh-plugin", "deepseek-harness", "shell", "powershell"],
  "exports": { ".": "./index.js", "./client": "./client.js", "./package.json": "./package.json" },
  "peerDependencies": {
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.6-alpha.1"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-api-remotes"] }
  },
  "scripts": { "test": "node --test tests/*.test.mjs" },
  "files": ["index.js", "shells.js", "client.js", "cordis.patch.yml", "README.md"]
}
