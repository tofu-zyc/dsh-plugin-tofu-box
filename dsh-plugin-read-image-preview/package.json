{
  "name": "dsh-plugin-read-image-preview",
  "version": "1.7.1",
  "engines": { "dsh": ">=0.2.0-rc.2 <0.3.0-0" },
  "license": "MIT",
  "keywords": ["dsh-plugin", "deepseek-harness", "dsh", "image", "preview", "screenshot", "tool-card", "ui"],
  "publishConfig": { "registry": "https://registry.npmjs.org" },
  "repository": { "type": "git", "url": "git+https://github.com/tofu-zyc/dsh-plugin-tofu-box.git", "directory": "dsh-plugin-read-image-preview" },
  "bugs": { "url": "https://github.com/tofu-zyc/dsh-plugin-tofu-box/issues" },
  "homepage": "https://github.com/tofu-zyc/dsh-plugin-tofu-box/tree/main/dsh-plugin-read-image-preview",
  "description": "会话图片的全屏查看与标注：接管官方图库位置（read_image 行、消息图片）与 computer-use 等工具卡片；查看器工具常驻，标记可选中/移动/改尺寸，滚轮缩放、触控板捏合与双指平移；回车把图片（含标注、按裁剪）直接放进输入框，也可复制或存进 ~/.dsh/screenshots；输入框旁一键抓屏后直接框选；设置页管理与按期清理截图。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": { "optional": true }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "files": [
    "client.js",
    "index.js",
    "cordis.patch.yml",
    "README.md"
  ]
}
