{
  "name": "dsh-plugin-read-image-preview",
  "version": "1.5.0",
  "license": "MIT",
  "keywords": ["dsh-plugin", "deepseek-harness", "dsh", "image", "preview", "screenshot", "tool-card", "ui"],
  "publishConfig": { "registry": "https://registry.npmjs.org" },
  "repository": { "type": "git", "url": "git+https://github.com/tofu-zyc/dsh-plugin-tofu-box.git", "directory": "dsh-plugin-read-image-preview" },
  "bugs": { "url": "https://github.com/tofu-zyc/dsh-plugin-tofu-box/issues" },
  "homepage": "https://github.com/tofu-zyc/dsh-plugin-tofu-box/tree/main/dsh-plugin-read-image-preview",
  "description": "通用工具图像卡片 + 截图标注工作区：read_image 走宿主文件预览，携带 image 附件的工具自动渲染缩略图；全屏查看器用滚轮缩放、Shift/Ctrl+滚轮平移，可画红框/椭圆/箭头/画笔/文字并裁剪，一键复制到剪贴板或存进 ~/.dsh/screenshots；输入框旁可一键抓全屏，设置页可管理与按期清理截图。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": { "optional": true }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "files": [
    "client.js",
    "index.js",
    "cordis.patch.yml",
    "README.md"
  ]
}
