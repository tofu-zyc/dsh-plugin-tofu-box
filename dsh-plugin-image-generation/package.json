{
  "name": "dsh-plugin-image-generation",
  "version": "0.2.0",
  "description": "从供应商拉取并搜索绘图模型，独立配置 OpenAI Images 工具和直接绘图面板，保留原图。",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "keywords": ["dsh-plugin", "deepseek-harness", "image-generation"],
  "repository": { "type": "git", "url": "git+https://github.com/tofu-zyc/dsh-plugin-tofu-box.git", "directory": "dsh-plugin-image-generation" },
  "exports": { ".": "./index.js", "./client": "./client.js", "./package.json": "./package.json" },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.6-alpha.1",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.6-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-ui-tool", "@deepseek-ai/dsh-api-remotes"] }
  },
  "scripts": { "test": "node --test tests/*.test.mjs" },
  "files": ["index.js", "core.js", "client.js", "cordis.patch.yml", "README.md"]
}
