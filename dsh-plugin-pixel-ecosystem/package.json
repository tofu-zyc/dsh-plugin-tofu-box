{
  "name": "dsh-plugin-pixel-ecosystem",
  "version": "0.1.0",
  "engines": { "dsh": ">=0.2.0-rc.2 <0.3.0-0" },
  "license": "MIT",
  "keywords": ["dsh-plugin", "deepseek-harness", "dsh", "pixel", "ecology", "simulation", "game", "sandbox", "terrarium"],
  "publishConfig": { "registry": "https://registry.npmjs.org" },
  "repository": { "type": "git", "url": "git+https://github.com/tofu-zyc/dsh-plugin-tofu-box.git", "directory": "dsh-plugin-pixel-ecosystem" },
  "bugs": { "url": "https://github.com/tofu-zyc/dsh-plugin-tofu-box/issues" },
  "homepage": "https://github.com/tofu-zyc/dsh-plugin-tofu-box/tree/main/dsh-plugin-pixel-ecosystem",
  "description": "像素生态缸：侧边栏点开就是一个整块主面板的像素生态沙盒。草和水草两条生产者链养出陆地与水下两个食物网——兔子、鹿、狐狸、狼、乌鸦，还有小鱼和狗鱼，它们吃草、啃叶、捕猎、繁殖、死亡，遗骸腐烂回肥力再养草，闭环。动物带可遗传的基因（速度 / 视野 / 体型 / 代谢 / 寿命 / 繁殖率），生崽时小幅变异，所以种群会自己波动；掠食者有领地，世界会自动补种免于灭绝。等 AI 干活时摸鱼用；世界存在浏览器本地，关掉页面再回来还在。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ]
}
