{
  "name": "dsh-plugin-codex-login",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Codex ChatGPT OAuth sign-in control for DSH Web model settings",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-models",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-credentials": ">=0.1.6-alpha.1",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.6-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "scripts": { "test": "node --test tests/*.test.mjs" },
  "files": ["index.js", "core.js", "client.js", "cordis.patch.yml", "README.md"]
}
