  "description": "computer-use v2.3：基于 Cua Driver 进程内 SDK 的跨平台桌面操作。13 个工具（截图/窗口列表/缩放/光标/移动/点击/拖拽/滚动/输入/按键/打开应用/连续动作/等待）。v2.3 修掉「打开已登录应用却要求重新登录」：open 先在窗口表里找已有窗口（官方推荐做法），找到就复用/唤醒，绝不启动第二个实例；确实没在跑才按应用的 launch_path/aumid 启动，并识别启动即退出的假成功。窗口表不可用时用 list_apps 的运行标记兜底避免重复启动。Windows 宿主进程自动切 Per-Monitor-V2 DPI 感知，命名驱动会话自动续命，默认后台注入不抢焦点，元素树+element_token 精确操作。无需守护进程/MCP/PowerShell。写操作走原生 tools/pre-execute 审批。",
  "type": "module",
  "main": "index.js",
  "dependencies": {
    "@trycua/cua-driver": "^0.28.1",
    "koffi": "^3.2.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true }
  },
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md"
  ]
}
