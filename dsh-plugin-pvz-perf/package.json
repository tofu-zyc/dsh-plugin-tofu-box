{
  "name": "dsh-plugin-pvz-perf",
  "version": "0.1.0",
  "engines": {
    "dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "pvz",
    "plants-vs-zombies",
    "game",
    "moyu",
    "panel"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tofu-zyc/dsh-plugin-tofu-box.git",
    "directory": "dsh-plugin-pvz-perf"
  },
  "bugs": {
    "url": "https://github.com/tofu-zyc/dsh-plugin-tofu-box/issues"
  },
  "homepage": "https://github.com/tofu-zyc/dsh-plugin-tofu-box/tree/main/dsh-plugin-pvz-perf",
  "description": "植物大战僵尸·摸鱼面板：把 pvz_perf 的网页版（WebGPU/WebGL 构建）嵌进 DSH。侧边栏点开就是整屏游戏浮层，点「隐藏」继续挂着跑，等 AI 干活时来一局；游戏文件留在本地磁盘，插件不打包、不分发任何游戏资源。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    },
    "umbrella": false
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ]
}
