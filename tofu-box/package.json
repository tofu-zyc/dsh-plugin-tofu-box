{
  "name": "tofu-box",
  "version": "1.0.0",
  "license": "MIT",
  "keywords": ["dsh-plugin", "deepseek-harness", "dsh", "tofu-box", "pack"],
  "publishConfig": { "registry": "https://registry.npmjs.org" },
  "repository": { "type": "git", "url": "git+https://github.com/tofu-zyc/dsh-plugin-tofu-box.git", "directory": "tofu-box" },
  "bugs": { "url": "https://github.com/tofu-zyc/dsh-plugin-tofu-box/issues" },
  "homepage": "https://github.com/tofu-zyc/dsh-plugin-tofu-box",
  "description": "TOFU BOX 伞包：一条命令装齐 tofu-zyc 的全套 dsh 插件（model-search、model-tuning、read-image-preview、shell-selector、computer-use、mcp-ui）。本包不含代码，只做两件事：以 dependencies 拉入六个子包，以 patch 层注册它们的插件行——即 dsh-base 同款 bundle 模式。装本包或单装子包，二选一，不要混装。",
  "type": "module",
  "dependencies": {
    "dsh-plugin-model-search": "^1.1.1",
    "dsh-plugin-model-tuning": "^2.0.1",
    "dsh-plugin-read-image-preview": "^1.4.1",
    "dsh-plugin-shell-selector": "^0.1.0",
    "dsh-plugin-computer-use": "^2.4.1",
    "dsh-plugin-mcp-ui": "^1.0.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.6-alpha.1",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.6-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@deepseek-ai/dsh-session-title-llm": ">=0.1.6-alpha.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-session-title-llm": { "optional": true }
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./patches/model-search.yml",
        "./patches/model-tuning.yml",
        "./patches/read-image-preview.yml",
        "./patches/shell-selector.yml",
        "./patches/computer-use.yml",
        "./patches/mcp-ui.yml"
      ]
    }
  },
  "files": [
    "patches/",
    "README.md"
  ]
}
