{
  "name": "dsh-plugin-model-tuning",
  "version": "2.0.0",
  "license": "MIT",
  "keywords": ["dsh-plugin", "deepseek-harness", "dsh", "model", "settings", "reasoning", "context", "session-title", "image-generation"],
  "publishConfig": { "registry": "https://registry.npmjs.org" },
  "repository": { "type": "git", "url": "git+https://github.com/tofu-zyc/dsh-plugin-tofu-box.git", "directory": "dsh-plugin-model-tuning" },
  "bugs": { "url": "https://github.com/tofu-zyc/dsh-plugin-tofu-box/issues" },
  "homepage": "https://github.com/tofu-zyc/dsh-plugin-tofu-box/tree/main/dsh-plugin-model-tuning",
  "description": "「设置 → 模型调参」页：模型参数（推理档位/上下文/最大输出/输入模态）、「用途」页（标题生成独立路由，替换宿主标题行）、「绘图」页（绘图模型配置 + generate_image 工具 + 直接绘图面板）。v2 合并了原 dsh-plugin-title-model 与 dsh-plugin-image-generation。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./core": "./core.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.6-alpha.1",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.6-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@deepseek-ai/dsh-session-title-llm": "^0.1.6-alpha.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-session-title-llm": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "files": [
    "client.js",
    "index.js",
    "core.js",
    "cordis.patch.yml",
    "README.md"
  ]
}
