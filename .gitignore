# 依赖与构建产物
node_modules/
dist/
/.pnpm-store/
*.tgz
*.zip

# 本地研发杂物（内部工具/笔记/实验素材，不进仓库）
/prototype/
/preview-test*.png
/proof_screenshot.png
/computer-use-research.md
/UPGRADE-CHECK.md
/check-compat.mjs
/publish.ps1
# UPGRADE-CHECK.md 升级流程的组合快照：before 留作基线，after 拿来 diff，都不入库
/compat-before.yml
/compat-after.yml
/.doctor-selftest/
# Isolated dsh 0.1.7-alpha.2 test install and home; production stays untouched.
/.dsh-017-test/
# Same isolation for the dsh 0.1.7-rc.1 branch checkout.
/.dsh-017rc1-test/
# Persistent production copy installed only during an approved cutover.
/.dsh-017-prod/
# Isolated dsh home + rc test profile for plugin development; never the live desktop profile.
/.dsh-rc-test/
# Isolated npm prefix holding one dsh rc build for upgrade compat verification.
/.rc3-deploy/
/.rc3-home/
# 插件测试用 dsh 运行时：rc/ = npm next 通道，alpha/ = npm alpha 通道（npm i -g --prefix 布局）。
# 配套的 rc-dev / alpha-dev profile 在 ~/.dsh/profiles，见 docs/TESTING-PROFILES.md。
/.dsh-runtime/
/deepseek-harness/
/.workbuddy/
/.chrome-new-instance/

# Agent/调试产物：截图、探针、临时渲染（见各插件 HANDOVER §12）
/.scratch/
/.agents/
**/.scratch/
**/__pycache__/
*.pyc
**/.chrome-verify/

# 系统与编辑器
.DS_Store
*.log
Thumbs.db

# 临时探针/构建产物（pvz 插件开发会话）
/.probe/
/.tmp/

# 插件安装源的一次性副本（链接安装用，卸载可安全删除）
/.agents/local-install/
